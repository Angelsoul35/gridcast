# GridCast configuration (prefix GC_)
GC_ENVIRONMENT=local
GC_MODEL_DIR=artifacts
GC_MLFLOW_TRACKING_URI=./mlruns        # local file store; set to a server URL in prod
GC_MLFLOW_EXPERIMENT=gridcast
GC_DRIFT_PSI_THRESHOLD=0.20            # PSI above this = drift
GC_RETRAIN_MAPE_THRESHOLD=0.12        # backtest MAPE above this = retrain
